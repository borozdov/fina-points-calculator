<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_logo_top"
                android:layout_width="wrap_content"
                android:layout_height="11dp"
                android:fontFamily="sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="FINA POINTS"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="8dp"
                android:fontFamily="sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="BY BOROZDOV"
                android:textColor="@color/widget_dim"
                android:textSize="6sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_mode"
            android:layout_width="84dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_button_accent"
            android:clickable="true"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="сек → очки"
            android:textColor="@color/widget_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_pool"
            android:layout_width="38dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_button"
            android:clickable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="25м"
            android:textColor="@color/widget_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_gender"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_button"
            android:clickable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="М"
            android:textColor="@color/widget_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_prev_event"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_button"
            android:clickable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="@color/widget_dim"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_event"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="50 в/с"
            android:textColor="@color/widget_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_event"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_button"
            android:clickable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="@color/widget_dim"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_dec"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_button"
            android:clickable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="−"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_value_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_value_background"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_value_label"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="СЕКУНДЫ"
                android:textColor="@color/widget_dim"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_value"
                android:layout_width="match_parent"
                android:layout_height="23dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="30.00"
                android:textColor="@color/widget_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_inc"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_button"
            android:clickable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/widget_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_result_label"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="ОЧКИ FINA"
                android:textColor="@color/widget_dim"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_result"
                android:layout_width="match_parent"
                android:layout_height="23dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="291"
                android:textColor="@color/widget_accent"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
